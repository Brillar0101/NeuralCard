# NeuralCard — what stays out of the repo.
#
# Rule of thumb: commit the SOURCE (schematic, board, custom libraries, and the
# scripts that generate them) plus the RELEASED fab package. Ignore anything a
# tool rewrites on its own, anything KiCad writes per-user, and anything that
# can be regenerated from the sources above.
#
# Baseline follows github/gitignore's KiCad.gitignore:
# https://github.com/github/gitignore/blob/main/KiCad.gitignore

# ---------------------------------------------------------------- KiCad backups
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_sym-bak
*-save.pro
*-save.kicad_pcb
*.000
_autosave-*
*-backups/
**/*-backups/*.zip
*.lck

# ---------------------------------------------------- KiCad local / per-user state
# Board-independent UI state. Differs per machine, causes pointless diffs.
*.kicad_prl
fp-info-cache
.history/

# --------------------------------------------------------- KiCad generated output
# All regenerated by the pipeline documented in README; never hand-edited.
*.erc
*.net
*-cache.lib
*-rescue.lib
NeuralCard.dsn
NeuralCard.ses

# Note: BOM_JLCPCB.csv and fab/*.csv ARE tracked on purpose — they are the
# release deliverables uploaded to JLCPCB, not incidental KiCad exports.

# --------------------------------------------------------------- heavy / derivable
tools/freerouting.jar
*.blend
*.blend1
*.glb
*.step
*.stp
JLC.3dshapes/
ST25DV.3dshapes/
datasheets/

# ------------------------------------------------------------- superseded fab runs
# Keep only the current fab/ bundle; dated snapshots live in git history.
fab.old-*/
fab.bak*/

# ------------------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------- editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*~
